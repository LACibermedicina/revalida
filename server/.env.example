# --- obrigatório em produção ---
NODE_ENV=development
JWT_SEGREDO=troque-por-32-ou-mais-caracteres-aleatorios
APP_URL=http://localhost:5173

# --- conta root (criada/garantida ao iniciar a API) ---
ROOT_EMAIL=root@m3d.pro
ROOT_SENHA=arcano123
# 1 = redefine a senha do root a partir daqui na próxima partida (use só para recuperar acesso)
ROOT_SENHA_REDEFINIR=0

# --- e-mail (recuperação de senha e token aprovado); sem isso o link aparece no console em desenvolvimento ---
# SMTP_URL=smtps://usuario:senha@smtp.exemplo.com
# EMAIL_DE=Revalida Prático <nao-responda@seudominio.com>

# --- vídeo Agora ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- instalador do primeiro acesso ---
# Por padrão um código aleatório é impresso no log da API a cada início enquanto o servidor não estiver instalado.
# Defina para fixar o código (ex.: instalação automatizada). Depois de instalar, não tem mais efeito.
# INSTALL_CODE=
# Parâmetros também podem vir do instalador (guardados no banco; segredos cifrados). O ambiente sempre tem prioridade:
# PHP_TOKEN_URL=

# --- nomes alternativos aceitos (úteis em hospedagens que já usam estes) ---
# SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS  (equivalem a SMTP_URL)
# MAIL_FROM (equivale a EMAIL_DE)   ROOT_PASSWORD (equivale a ROOT_SENHA; e-mail padrão root@m3d.pro)
# Câmera e microfone só funcionam em HTTPS: use um domínio com certificado em APP_URL (http://IP:porta não serve).
